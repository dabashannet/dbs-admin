<template>
  <a-drawer
    v-if="mode === 'drawer'"
    v-model:visible="visible"
    :title="isEdit ? editTitleText : addTitleText"
    :width="drawerWidthCurrent"
    :height="'calc(100vh - 72px)'"
    :drawer-style="{ marginTop: '36px', marginBottom: '36px' }"
    :mask-closable="false"
    :unmount-on-close="true"
    :footer="false"
  >
    <FormBody />
  </a-drawer>

  <a-modal
    v-else-if="mode === 'modal'"
    v-model:visible="visible"
    :title="isEdit ? editTitleText : addTitleText"
    :width="modalWidth"
    :top="36"
    :align-center="false"
    :modal-style="{ maxHeight: 'calc(100vh - 72px)', display: 'flex', flexDirection: 'column' }"
    :body-style="{ overflow: 'auto', paddingBottom: '36px' }"
    :mask-closable="false"
    :unmount-on-close="true"
    :footer="false"
  >
    <FormBody />
  </a-modal>

  <a-card v-else class="general-card form-page-card" :bordered="false">
    <FormBody />
  </a-card>
</template>

<script lang="ts" setup>
import { ref, reactive, computed, defineComponent, h, resolveComponent, resolveDynamicComponent, shallowRef, onBeforeUnmount } from 'vue';
import { Message } from '@arco-design/web-vue';
import axios from '@/api/interceptor';
import Upload from '@/components/Upload/index.vue';
import '@wangeditor/editor/dist/css/style.css';
import { Editor, Toolbar } from '@wangeditor/editor-for-vue';

const props = defineProps<{
  apiPrefix: string;
  drawerWidth?: number | string;
  defaultMode?: 'drawer' | 'modal' | 'page';
  addTitle?: string;
  editTitle?: string;
}>();

const emit = defineEmits<{
  (e: 'saved', record: any): void;
  (e: 'cancel'): void;
}>();

const visible = ref(false);
const isEdit = ref(false);
const editId = ref<number | null>(null);
const submitting = ref(false);
const formRef = ref();
const formData = reactive<Record<string, any>>({});
const formFields = ref<any[]>([]);
const formConfig = ref<any>(null);

const mode = ref<'drawer' | 'modal' | 'page'>(props.defaultMode || 'modal');
const drawerWidthCurrent = ref<number | string>(props.drawerWidth || 600);
const modalWidth = ref<number | string>(600);

const drawerWidth = computed(() => props.drawerWidth || 600);
const addTitleText = computed(() => props.addTitle || '新增');
const editTitleText = computed(() => props.editTitle || '编辑');

const resolveApiUrl = (url: string): string => {
  try {
    if (typeof url !== 'string' || !url.startsWith('/plugin/')) return url;

    const base = (axios as any)?.defaults?.baseURL;
    if (typeof base === 'string' && /^https?:\/\//i.test(base)) {
      const origin = new URL(base).origin;
      return `${origin}${url}`;
    }

    if (typeof window !== 'undefined' && window.location?.origin) {
      return `${window.location.origin}${url}`;
    }

    return url;
  } catch {
    return url;
  }
};

const visibleFields = computed(() => {
  return formFields.value.filter((f) => isFieldVisible(f));
});

const normalizeOptionKey = (value: any): string => {
  if (value === true) return '1';
  if (value === false) return '0';
  return String(value ?? '');
};

const normalizeFormDataBySchema = () => {
  formFields.value.forEach((f: any) => {
    const key = f?.key;
    if (!key) return;
    const type = f?.type || 'text';
    const hasOptions = f?.options && typeof f.options === 'object';
    if (type === 'switch') {
      const v = formData[key];
      if (v === undefined || v === null || v === '') return;
      if (typeof v !== 'boolean') {
        formData[key] = normalizeOptionKey(v);
      }
      return;
    }
    if ((type === 'select' || type === 'radio' || type === 'treeSelect' || type === 'cascader') && hasOptions) {
      const v = formData[key];
      if (v === undefined || v === null || v === '') return;
      formData[key] = String(v);
    }
  });
};

const isFieldVisible = (field: any): boolean => {
  if (!field) return false;
  if (isEdit.value && field.creationOnly) return false;
  if (!isEdit.value && field.updateOnly) return false;
  if (field.type === 'hidden') return false;
  if (field.displayWhen) {
    const depValue = formData[field.displayWhen.field];
    const operator = field.displayWhen.operator;
    const value = field.displayWhen.value;
    switch (operator) {
      case '==': return depValue == value;
      case '!=': return depValue != value;
      case '>': return depValue > value;
      case '<': return depValue < value;
      case '>=': return depValue >= value;
      case '<=': return depValue <= value;
      case 'in': return Array.isArray(value) ? value.includes(depValue) : depValue === value;
      case 'notIn': return Array.isArray(value) ? !value.includes(depValue) : depValue !== value;
      default: return true;
    }
  }
  return true;
};

const getFieldRules = (field: any) => {
  const rules: any[] = [];
  if (field.required) {
    rules.push({ required: true, message: `请输入${field.title}` });
  }
  return rules;
};

const RichTextEditor = defineComponent({
  name: 'DynamicRichTextEditor',
  props: {
    modelValue: {
      type: String,
      default: '',
    },
    placeholder: {
      type: String,
      default: '',
    },
  },
  emits: ['update:modelValue'],
  setup(props, { emit }) {
    const editorRef = shallowRef<any>();
    const mode = 'default';
    const toolbarConfig = {};
    const editorConfig = computed(() => ({
      placeholder: props.placeholder || '请输入内容...',
    }));

    const handleCreated = (editor: any) => {
      editorRef.value = editor;
    };

    onBeforeUnmount(() => {
      const editor = editorRef.value;
      if (!editor) return;
      editor.destroy();
    });

    return () =>
      h(
        'div',
        { style: { width: '100%', border: '1px solid var(--color-border)', borderRadius: '4px', overflow: 'hidden' } },
        [
          h(Toolbar as any, {
            editor: editorRef,
            defaultConfig: toolbarConfig,
            mode,
            style: { borderBottom: '1px solid var(--color-border)' },
          }),
          h(Editor as any, {
            modelValue: props.modelValue,
            'onUpdate:modelValue': (v: any) => emit('update:modelValue', v),
            defaultConfig: editorConfig.value,
            mode,
            onCreated: handleCreated,
            style: { height: '240px', overflowY: 'hidden' },
          }),
        ]
      );
  },
});

const getComponent = (field: any) => {
  const type = field.type || 'text';
  const map: Record<string, any> = {
    text: 'a-input',
    password: 'a-input-password',
    email: 'a-input',
    url: 'a-input',
    number: 'a-input-number',
    textarea: 'a-textarea',
    select: 'a-select',
    radio: 'a-radio-group',
    checkbox: 'a-checkbox-group',
    switch: 'a-switch',
    slider: 'a-slider',
    rate: 'a-rate',
    color: 'a-color-picker',
    tags: 'a-input-tag',
    treeSelect: 'a-tree-select',
    cascader: 'a-cascader',
    date: 'a-date-picker',
    datetime: 'a-date-picker',
    dateTime: 'a-date-picker',
    time: 'a-time-picker',
    dateRange: 'a-range-picker',
    month: 'a-date-picker',
    year: 'a-date-picker',
    image: Upload,
    images: Upload,
    file: Upload,
    files: Upload,
    code: 'a-textarea',
    editor: RichTextEditor,
    icon: 'a-input',
  };
  return map[type] || 'a-input';
};

const getFieldProps = (field: any) => {
  const type = field.type || 'text';
  const p: any = {};
  if (field.placeholder) p.placeholder = field.placeholder;
  if (field.disabled) p.disabled = true;
  if (field.readonly) p.readonly = true;
  if (field.maxLength) p.maxLength = field.maxLength;
  if (field.clearable !== false) p.allowClear = true;

  if (type === 'textarea') {
    p.autoSize = { minRows: field.rows || 3 };
  }
  if (type === 'switch') {
    const v = formData[field.key];
    const has01 = field?.options && (field.options['1'] !== undefined || field.options['0'] !== undefined);
    if (typeof v !== 'boolean' || has01) {
      p.checkedValue = '1';
      p.uncheckedValue = '0';
      p.checkedText = field?.options?.['1'] ?? field?.options?.[1];
      p.uncheckedText = field?.options?.['0'] ?? field?.options?.[0];
    }
  }
  if (type === 'date') {
    p.format = field.format || 'YYYY-MM-DD';
  }
  if (type === 'datetime' || type === 'dateTime') {
    p.showTime = true;
    p.format = field.format || 'YYYY-MM-DD HH:mm:ss';
  }
  if (type === 'select' || type === 'radio' || type === 'checkbox' || type === 'treeSelect' || type === 'cascader') {
    const opts = field.options
      ? Object.entries(field.options).map(([value, label]) => ({ value, label: label as string }))
      : [];
    if (opts.length > 0) p.options = opts;
    if (field.multiple) p.multiple = true;
    if (field.searchable) p.allowSearch = true;
  }
  if (type === 'image' || type === 'images' || type === 'file' || type === 'files') {
    p.limit = type === 'image' || type === 'file' ? 1 : Number(field.maxUpload || 10);
    p.type = type === 'file' || type === 'files' ? 'file' : 'image';
  }
  return p;
};

const resetForm = () => {
  Object.keys(formData).forEach((k) => delete formData[k]);
};

const ensureDefaults = () => {
  formFields.value.forEach((f: any) => {
    const key = f?.key;
    if (!key) return;
    if (formData[key] !== undefined) return;
    if (f.default !== undefined && f.default !== null) {
      formData[key] = f.default;
      return;
    }
    const type = f.type || 'text';
    if (type === 'images' || type === 'files' || type === 'checkbox') {
      formData[key] = [];
      return;
    }
    formData[key] = '';
  });
};

const loadSchema = async (context: 'create' | 'update') => {
  const resp = await axios.get(resolveApiUrl(`${props.apiPrefix}/form-schema`), {
    params: { context },
  });
  const data = resp?.data?.data || resp?.data || resp;
  formFields.value = data.fields || [];
  formConfig.value = data.config || data.formConfig || null;
};

const loadRecord = async (id: number) => {
  const resp = await axios.get(resolveApiUrl(`${props.apiPrefix}/${id}`));
  const data = resp?.data?.data || resp?.data || resp;
  const record = data.data || data;
  Object.assign(formData, record || {});
  formFields.value.forEach((f: any) => {
    const key = f?.key;
    const type = f?.type || 'text';
    if (!key) return;
    if (type !== 'images' && type !== 'files' && type !== 'checkbox') return;
    const v = formData[key];
    if (Array.isArray(v)) return;
    if (v === null || v === undefined || v === '') {
      formData[key] = [];
      return;
    }
    if (typeof v === 'string') {
      try {
        const parsed = JSON.parse(v);
        if (Array.isArray(parsed)) {
          formData[key] = parsed;
        }
      } catch {
        formData[key] = [];
      }
    }
  });
};

const openAdd = async () => {
  resetForm();
  isEdit.value = false;
  editId.value = null;
  await loadSchema('create');
  ensureDefaults();
  normalizeFormDataBySchema();
  if (mode.value !== 'page') {
    visible.value = true;
  }
};

const openAddWithOptions = async (options?: { mode?: 'drawer' | 'modal' | 'page'; drawerProps?: any; modalProps?: any }) => {
  if (options?.mode) mode.value = options.mode;
  if (options?.drawerProps?.width !== undefined) drawerWidthCurrent.value = options.drawerProps.width;
  else drawerWidthCurrent.value = drawerWidth.value;
  if (options?.modalProps?.width !== undefined) modalWidth.value = options.modalProps.width;
  else modalWidth.value = 600;
  await openAdd();
};

const openEdit = async (record: any) => {
  resetForm();
  isEdit.value = true;
  editId.value = Number(record?.id);
  await loadSchema('update');
  if (editId.value) {
    await loadRecord(editId.value);
  } else {
    Object.assign(formData, record || {});
  }
  ensureDefaults();
  normalizeFormDataBySchema();
  if (mode.value !== 'page') {
    visible.value = true;
  }
};

const openEditWithOptions = async (record: any, options?: { mode?: 'drawer' | 'modal' | 'page'; drawerProps?: any; modalProps?: any }) => {
  if (options?.mode) mode.value = options.mode;
  if (options?.drawerProps?.width !== undefined) drawerWidthCurrent.value = options.drawerProps.width;
  else drawerWidthCurrent.value = drawerWidth.value;
  if (options?.modalProps?.width !== undefined) modalWidth.value = options.modalProps.width;
  else modalWidth.value = 600;
  await openEdit(record);
};

const handleSubmit = async () => {
  try {
    if (submitting.value) return;
    submitting.value = true;
    await formRef.value?.validate?.();
    if (isEdit.value && editId.value) {
      const resp = await axios.put(resolveApiUrl(`${props.apiPrefix}/${editId.value}`), formData);
      const data = resp?.data?.data || resp?.data || resp;
      Message.success('保存成功');
      if (mode.value !== 'page') {
        visible.value = false;
      }
      emit('saved', data);
      return;
    }
    const resp = await axios.post(resolveApiUrl(`${props.apiPrefix}`), formData);
    const data = resp?.data?.data || resp?.data || resp;
    Message.success('保存成功');
    if (mode.value !== 'page') {
      visible.value = false;
    }
    emit('saved', data);
  } catch (e: any) {
    Message.error(e?.response?.data?.msg || e?.message || '保存失败');
  } finally {
    submitting.value = false;
  }
};

const handleCancel = () => {
  if (mode.value === 'page') {
    emit('cancel');
    return;
  }
  visible.value = false;
};

const FormBody = defineComponent({
  name: 'DynamicFormBody',
  setup() {
    const AForm = resolveComponent('a-form') as any;
    const AFormItem = resolveComponent('a-form-item') as any;
    const ASpace = resolveComponent('a-space') as any;
    const AButton = resolveComponent('a-button') as any;
    return () =>
      h(
        'div',
        { class: 'dynamic-form-wrap' },
        h(
          AForm,
          {
            ref: formRef,
            model: formData,
            layout: formConfig.value?.layout || 'horizontal',
            labelWidth: formConfig.value?.labelWidth || 120,
            autoLabelWidth: true,
            class: 'dynamic-form',
          } as any,
          {
            default: () => [
              ...visibleFields.value.map((field: any) =>
                h(
                  AFormItem,
                  { key: field.key, field: field.key, label: field.title, rules: getFieldRules(field) } as any,
                  {
                    default: () =>
                      h(
                        resolveDynamicComponent(getComponent(field)) as any,
                        {
                          modelValue: formData[field.key],
                          'onUpdate:modelValue': (v: any) => (formData[field.key] = v),
                          ...getFieldProps(field),
                        } as any
                      ),
                  }
                )
              ),
              h(
                AFormItem,
                {},
                {
                  default: () =>
                    h(
                      ASpace,
                      {},
                      () => [
                        h(
                          AButton,
                          { type: 'primary', loading: submitting.value, onClick: handleSubmit } as any,
                          () => '确定'
                        ),
                        h(
                          AButton,
                          { disabled: submitting.value, onClick: handleCancel } as any,
                          () => '取消'
                        ),
                      ]
                    ),
                }
              ),
            ],
          }
        )
      );
  },
});

defineExpose({ openAdd: openAddWithOptions, openEdit: openEditWithOptions, setMode: (m: any) => (mode.value = m) });
</script>

<style scoped lang="less">
.dynamic-form {
  padding-right: 16px;
}
.form-page-card :deep(.arco-card-body) {
  padding: 16px;
}

:deep(.arco-modal-wrapper) {
  align-items: flex-start;
  padding-top: 36px;
  padding-bottom: 36px;
}

:deep(.arco-modal) {
  max-height: calc(100vh - 72px);
  display: flex;
  flex-direction: column;
}

:deep(.arco-modal-body) {
  overflow: auto;
  padding-bottom: 36px;
}

:deep(.arco-drawer-body) {
  padding-bottom: 36px;
}
</style>
